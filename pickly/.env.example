# Supabase project (local: run `npx supabase start` and copy the printed values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Show the demo account shortcuts on the sign-in page. Never enable in production.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Server-only. Required from Milestone 3 (admin invitations). Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
